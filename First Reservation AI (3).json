    {
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nconst teil = text.split(\"RESERVIERUNG:\")[1];\nconst parts = teil.split(\",\");\n\nconst name = parts[0].split(\"=\")[1].trim();\nlet datum = parts[1].split(\"=\")[1].trim();\nlet uhrzeit = parts[2].split(\"=\")[1].trim();\nconst personen = parts[3].split(\"=\")[1].trim();\n\nconst datumTeile = datum.replace(/\\//g, '.').split('.');\nif (datumTeile[0].length === 1) datumTeile[0] = '0' + datumTeile[0];\nif (datumTeile[1].length === 1) datumTeile[1] = '0' + datumTeile[1];\n\nif (!uhrzeit.includes(':')) uhrzeit = uhrzeit.replace(' Uhr','').trim() + ':00';\n\nconst startISO = datumTeile[2] + '-' + datumTeile[1] + '-' + datumTeile[0] + 'T' + uhrzeit + ':00+02:00';\nconst endStunde = (parseInt(uhrzeit.split(':')[0]) + 1).toString().padStart(2,'0');\nconst endISO = datumTeile[2] + '-' + datumTeile[1] + '-' + datumTeile[0] + 'T' + endStunde + ':' + uhrzeit.split(':')[1] + ':00+02:00';\n\nreturn [{ json: { name, datum, uhrzeit, personen, startISO, endISO } }];"
      },
